{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Beaver2323/Subgraph-Fusion-Pass-Optimization/main/upstream/reference_plan.schema.json",
  "title": "GPU Reference Execution Plan",
  "$comment": "更新时间：2026-09-06 02:21 CST；原生优先。支持性能方案导航、codegen-only 证据与适配入口预期执行数，不以缺失数值断言冒充性能门禁通过。",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "generated_at",
    "status",
    "manifest",
    "execution_policy",
    "cases",
    "non_executed_variants"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string"},
    "performance_plan": {
      "type": "object", "required": ["path", "status"], "additionalProperties": false,
      "properties": {"path": {"type": "string"}, "status": {"type": "string"}}
    },
    "case_guide": {
      "type": "object", "required": ["path", "language"], "additionalProperties": false,
      "properties": {"path": {"type": "string"}, "language": {"const": "zh-CN"}}
    },
    "manifest": {
      "type": "object",
      "required": ["path", "schema_version", "pytorch_commit"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "schema_version": {"type": "string"},
        "pytorch_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "order",
        "case_isolation",
        "failure_behavior",
        "artifact_capture",
        "benchmark_gate",
        "default_timeout_seconds"
      ],
      "additionalProperties": false,
      "properties": {
        "order": {
          "const": "native-community-test-first-then-minimal-adapter-if-required"
        },
        "case_isolation": {"const": "fresh-process"},
        "failure_behavior": {"const": "continue-and-record"},
        "artifact_capture": {"type": "string"},
        "benchmark_gate": {"const": "functional-reference-valid-first"},
        "default_timeout_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "non_executed_variants": {
      "type": "array",
      "items": {"$ref": "#/$defs/non_executed_variant"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "acceptance_unit_id",
        "source_test",
        "tracking_mode",
        "variant_ids",
        "expected_match",
        "expected_assertions",
        "required_artifacts",
        "benchmark"
      ],
      "properties": {
        "case_id": {"type": "string", "pattern": "^REF-"},
        "acceptance_unit_id": {"type": "string", "pattern": "^AU-"},
        "source_test": {"type": "string"},
        "tracking_mode": {"enum": ["direct", "adapter", "extracted"]},
        "correctness_evidence": {"enum": ["community-numerical-assertion", "codegen-only"]},
        "expected_tests": {"type": "integer", "minimum": 1},
        "variant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "expected_match": {
          "oneOf": [
            {"type": "boolean"},
            {"enum": ["mixed", "not-directly-asserted"]}
          ]
        },
        "expected_assertions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["fx-before", "fx-after"]}
        },
        "benchmark": {
          "enum": [
            "not-configured-first-reference-wave",
            "not-configured-functional-reference",
            "not-configured-negative-guard",
            "not-configured-regression",
            "community-benchmark-source-functional-default",
            "community-e2e-benchmark-source-functional-default",
            "community-functional-default"
          ]
        },
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "direct_args": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "entrypoint": {"type": "string"},
        "direct_blocker": {"$ref": "#/$defs/direct_blocker"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "tracking_mode": {"enum": ["adapter", "extracted"]}
            }
          },
          "then": {"required": ["entrypoint", "direct_blocker"]}
        }
      ]
    },
    "direct_blocker": {
      "type": "object",
      "required": ["direct_case_id", "artifact_ref", "classification"],
      "properties": {
        "direct_case_id": {"type": "string", "pattern": "^REF-"},
        "artifact_ref": {"type": "string"},
        "classification": {
          "enum": [
            "device-constant-blocker",
            "backend-injection-blocker",
            "artifact-capture-blocker"
          ]
        }
      },
      "additionalProperties": false
    },
    "non_executed_variant": {
      "type": "object",
      "required": [
        "acceptance_unit_id",
        "variant_id",
        "disposition",
        "reason"
      ],
      "properties": {
        "acceptance_unit_id": {"type": "string", "pattern": "^AU-"},
        "variant_id": {"type": "string"},
        "disposition": {
          "enum": [
            "static-registration-evidence-only",
            "not-applicable-reference-guard"
          ]
        },
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
