+# Copyright (c) 2026, Huawei Technologies Co., Ltd
+"""Exact FP32 log2/ceil E8M0 encoding for triton_experimental.
+
+Normal positive inputs follow upstream pre-SM100 integer exponent extraction.
+Handle subnormals and non-positive/NaN inputs explicitly: tensor metadata alone
+cannot prove the positive-normal input assumption used by the upstream rewrite.
+"""
+import torch
+
+from torch._inductor.pattern_matcher import fwd_only, init_once_fakemode, register_replacement
+
+from . import config as ncfg
+
+
+def e8m0_rceil_log2_pattern(inp):
+    return (torch.clamp(torch.ceil(torch.log2(inp)), -127, 127) + 127).to(torch.uint8)
+
+
+def e8m0_rceil_log2_replacement(inp):
+    bits = inp.view(torch.int32)
+    exponent = (bits >> 23) & 0xFF
+    mantissa = bits & 0x7FFFFF
+    normal = torch.clamp(exponent + (mantissa != 0).to(torch.int32), 0, 254)
+    # Subnormals cross the only unsaturated exponent boundary at exactly 2^-127.
+    # The corresponding mantissa is 2^22; ceil rounds up only strictly above it.
+    subnormal = (mantissa > 0x400000).to(torch.int32)
+    encoded = torch.where(exponent == 0, subnormal, normal)
+    # Preserve NPU log2/clamp/to(uint8) behavior for negative values and NaNs.
+    # +inf saturates to 254; both signs of zero encode as zero.
+    invalid = (bits < 0) | ((exponent == 0xFF) & (mantissa != 0))
+    return torch.where(invalid, 0, encoded).to(torch.uint8)
+
+
+def e8m0_extra_check(match):
+    if not ncfg.enable_e8m0_rceil_log2:
+        return False
+    inp = match.kwargs.get("inp")
+    value = inp.meta.get("val") if inp is not None else None
+    return value is not None and value.device.type == "npu" and value.dtype == torch.float32
+
+
+@init_once_fakemode
+def register_e8m0_pattern():
+    from torch._inductor.fx_passes.post_grad import pass_patterns
+
+    # Fake CPU example traces device-independent operator structure without
+    # allocating an accelerator tensor during backend activation.
+    register_replacement(
+        e8m0_rceil_log2_pattern,
+        e8m0_rceil_log2_replacement,
+        [torch.empty(32, dtype=torch.float32)],
+        fwd_only,
+        [pass_patterns[1]],
+        extra_check=e8m0_extra_check,
+        skip_duplicates=True,
+        pattern_name="e8m0_rceil_log2_pattern",
+    )
