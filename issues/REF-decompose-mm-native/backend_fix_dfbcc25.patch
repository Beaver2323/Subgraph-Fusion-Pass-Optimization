+from types import SimpleNamespace
 from unittest import mock
 
 import sympy
@@ -14,10 +15,40 @@ from torch.utils._ordered_set import OrderedSet
 from torch_npu._inductor.triton_experimental import ir
 from torch_npu._inductor.triton_experimental import lowering as experimental_lowering
 from torch_npu._inductor.triton_experimental import lowering_override_list
+from torch_npu._inductor.triton_experimental import overrides
 from torch_npu._inductor.triton_experimental.codegen import triton as npu_triton_codegen
 
 
 class TestTritonExperimentalRegressions(TestCase):
+    def test_small_mm_pointwise_is_disabled_only_for_npu(self):
+        from torch._inductor.kernel import mm as upstream_mm
+
+        original = mock.Mock(return_value=True)
+        original._torch_npu_small_mm_guard = False
+        with mock.patch.object(upstream_mm, "_use_small_mm_pointwise", original):
+            overrides._disable_small_mm_pointwise_on_npu()
+            guarded = upstream_mm._use_small_mm_pointwise
+
+            npu_layout = SimpleNamespace(device=torch.device("npu"))
+            self.assertFalse(guarded(2048, 2, 2, npu_layout))
+            original.assert_not_called()
+
+            cuda_layout = SimpleNamespace(device=torch.device("cuda"))
+            self.assertTrue(guarded(2048, 2, 2, cuda_layout))
+            original.assert_called_once_with(2048, 2, 2, cuda_layout)
+
+    def test_small_mm_pointwise_guard_install_is_idempotent(self):
+        from torch._inductor.kernel import mm as upstream_mm
+
+        original = mock.Mock(return_value=True)
+        original._torch_npu_small_mm_guard = False
+        with mock.patch.object(upstream_mm, "_use_small_mm_pointwise", original):
+            overrides._disable_small_mm_pointwise_on_npu()
+            first = upstream_mm._use_small_mm_pointwise
+            overrides._disable_small_mm_pointwise_on_npu()
+
+            self.assertIs(upstream_mm._use_small_mm_pointwise, first)
+
     def test_cat_store_dtype_accepts_subgraph_lowering(self):
         value = object.__new__(SubgraphLowering)
 
diff --git a/torch_npu/_inductor/triton_experimental/overrides.py b/torch_npu/_inductor/triton_experimental/overrides.py
index 193cdd840..440218f55 100644
--- a/torch_npu/_inductor/triton_experimental/overrides.py
+++ b/torch_npu/_inductor/triton_experimental/overrides.py
@@ -19,6 +19,7 @@ dynamo ``config`` flag flips, backend-specific IR adjustments, and the pointwise
 autotuning gate that rebinds our own heuristics module. Importing this module
 still has the config side effect of turning ``size_asserts`` off.
 """
+import functools
 import logging
 
 from . import config as ncfg
@@ -84,11 +85,36 @@ def _disable_pad_mm_pass():
     inductor_config.shape_padding = False
 
 
+def _disable_small_mm_pointwise_on_npu():
+    """Keep NPU mm out of the upstream CUDA-oriented small-mm lowering.
+
+    The upstream small-mm heuristic expands ``mm`` into pointwise multiply/add
+    kernels for very small K/N.  The experimental NPU codegen does not yet
+    preserve correctness for this IR in AOTAutograd backward, so retain the
+    reliable extern ``mm`` path until that codegen support is fixed.
+    """
+    from torch._inductor.kernel import mm as mm_kernel
+
+    current = mm_kernel._use_small_mm_pointwise
+    if getattr(current, "_torch_npu_small_mm_guard", False):
+        return
+
+    @functools.wraps(current)
+    def npu_safe_small_mm_pointwise(m, k, n, layout):
+        if layout.device.type == "npu":
+            return False
+        return current(m, k, n, layout)
+
+    npu_safe_small_mm_pointwise._torch_npu_small_mm_guard = True
+    mm_kernel._use_small_mm_pointwise = npu_safe_small_mm_pointwise
+
+
 def apply_npu_overrides():
     # config-flag flips + FX passes that don't touch the decomposition table.
     _override_disable_pointwise_autotuning()
     _disable_recursive_dict_tag_guards()
     _disable_pad_mm_pass()
+    _disable_small_mm_pointwise_on_npu()
     _disable_addmm_fusion_pass()
     _install_safe_stride_order()
     _install_fold_max1_in_loop_merge()
